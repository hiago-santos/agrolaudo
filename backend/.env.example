# Copie para .env e ajuste os valores antes de rodar.

# String de conexão do PostgreSQL (Prisma)
# Dev local: aponte para o seu PostgreSQL já instalado (crie o banco "agrolaudo_db"
# antes). Se preferir usar o container do docker-compose em vez do Postgres nativo,
# troque para a porta 5433 (mapeada assim para não conflitar com uma instância local
# já ouvindo em 5432) e o usuário/senha definidos em docker-compose.yml.
DATABASE_URL="postgresql://postgres:123@localhost:5432/agrolaudo_db?schema=public"

# Segredo de autenticação (access JWT) — GERE um novo valor em produção, nunca reutilize o de dev.
# Access token dura 1 h; a sessão longa vem do refresh token (7 dias, ou 30 dias com "lembrar-me").
JWT_SECRET="dev-only-change-me"

PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Origem(s) permitida(s) pelo CORS — URL do frontend em produção.
# Várias origens: separe por vírgula (ex.: https://app.exemplo.com,https://xxx.up.railway.app).
CORS_ORIGIN="http://localhost:5173"

# URL pública usada para montar os links de assinatura enviados ao produtor/agrônomo.
PUBLIC_APP_URL="http://localhost:5173"

# MinIO — armazenamento de anexos dos projetos (S3-compatible).
# Produção: aponte para o MinIO no Railway (host público, sem https:// no endpoint).
# MINIO_USE_SSL=true se o endpoint for HTTPS; MINIO_PORT=443 nesse caso.
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="agrolaudo"
MINIO_REGION="us-east-1"
