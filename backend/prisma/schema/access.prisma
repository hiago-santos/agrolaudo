// ─────────────────────────── Access ───────────────────────────

enum UserRole {
  ADMIN
  AGRONOMIST
  BANK
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          UserRole       @default(AGRONOMIST)
  active        Boolean        @default(true)
  agronomist    Agronomist?
  refreshTokens RefreshToken[]

  /// Projetos que este usuário (papel BANK) decidiu (aprovou/reprovou).
  reviewedProjects  Project[] @relation("BankReviewer")
  /// Projetos que este usuário (papel BANK) abriu como "casca" (ver Project.initiatedBy).
  initiatedProjects Project[] @relation("ProjectInitiator")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Token opaco de renovação — só o hash fica persistido; o valor cru vai para o cliente.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  remember  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// Perfil do Engenheiro Agrônomo que assina os projetos. 1:1 com um User de role AGRONOMIST.
model Agronomist {
  id                     String  @id @default(uuid(7)) @db.Uuid
  userId                 String  @unique @map("user_id") @db.Uuid
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  document               String  @unique
  licenseNumber          String  @map("license_number")
  region                 String?
  issuingCity            String  @map("issuing_city")
  defaultSignatureBase64 String? @map("default_signature_base64")

  projects Project[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agronomists")
}
