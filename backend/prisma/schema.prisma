generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum RoleUsuario {
  ADMIN
  AGRONOMO
  BANCO
}

enum ClassificacaoProdutor {
  PRONAF
  PRONAMP
  DEMAIS
}

enum CategoriaAtividade {
  GRAOS_FIBRAS
  PERMANENTES_FRUTICULTURA
  SEMIPERMANENTES
  PECUARIA_PASTAGEM
}

enum StatusLaudo {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
}

enum TipoAssinatura {
  AGRONOMO
  PRODUTOR
}

// ─────────────────────────── Acesso ───────────────────────────

model User {
  id        String      @id @default(cuid())
  nome      String
  email     String      @unique
  senhaHash String
  role      RoleUsuario @default(AGRONOMO)
  ativo     Boolean     @default(true)
  agronomo  Agronomo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

/// Perfil do Engenheiro Agrônomo que assina os laudos. 1:1 com um User de role AGRONOMO.
model Agronomo {
  id                     String @id @default(cuid())
  userId                 String @unique
  user                   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                   String
  cpf                    String @unique
  crea                   String
  regiao                 String?
  cidadeEmissao          String
  assinaturaPadraoBase64 String?

  laudos Laudo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agronomos")
}

// ─────────────────────────── Cadastros base ───────────────────────────

model Produtor {
  id            String                 @id @default(cuid())
  nome          String
  cpfCnpj       String                 @unique
  telefone      String?
  email         String?
  endereco      String?
  municipio     String
  uf            String
  classificacao ClassificacaoProdutor  @default(DEMAIS)

  propriedades Propriedade[]
  laudos       Laudo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nome])
  @@map("produtores")
}

model Propriedade {
  id                String   @id @default(cuid())
  produtorId        String
  produtor          Produtor @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  nome              String
  matricula         String
  municipio         String
  uf                String
  areaTotalHa       Decimal  @db.Decimal(14, 2)
  inscricaoEstadual String?
  car               String?
  latitude          Decimal? @db.Decimal(9, 6)
  longitude         Decimal? @db.Decimal(9, 6)

  laudos Laudo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produtorId, matricula])
  @@index([produtorId])
  @@map("propriedades")
}

// ─────────────────────────── Culturas e cotações ───────────────────────────

/// As 15 atividades mapeadas com o cliente. Slug/categoria/unidades espelham o
/// catálogo estático de backend/src/core/atividades.ts — o seed importa de lá para
/// não ter dois lugares descrevendo a mesma coisa.
model Atividade {
  id                 String             @id @default(cuid())
  slug               String             @unique
  nome               String
  categoria          CategoriaAtividade
  unidadePadrao      String
  unidadesPermitidas String[]
  pecuaria           Boolean            @default(false)
  ativo              Boolean            @default(true)
  ordem              Int                @default(0)

  cotacoes   CotacaoRef[]
  laudoItens LaudoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("atividades")
}

/// Append-only: atualizar um preço insere uma nova linha em vez de sobrescrever.
/// A matriz de preços exibe sempre a última `vigenteDesde` por atividade, e isso
/// dá de graça o histórico de cotações pedido na conversa com o cliente.
model CotacaoRef {
  id            String    @id @default(cuid())
  atividadeId   String
  atividade     Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  unidade       String
  precoUnitario Decimal   @db.Decimal(18, 4)
  custoPorHa    Decimal   @db.Decimal(18, 4)
  regiao        String?
  vigenteDesde  DateTime  @default(now())
  criadoPorId   String?

  createdAt DateTime @default(now())

  @@index([atividadeId, vigenteDesde])
  @@map("cotacoes_referencia")
}

model Safra {
  id     String   @id @default(cuid())
  rotulo String   @unique
  inicio DateTime
  fim    DateTime
  ativa  Boolean  @default(true)

  laudos Laudo[]

  @@map("safras")
}

/// Contador atômico para a numeração LAUDO-{ano}-{sequencial}. Uma linha por ano,
/// lida com SELECT ... FOR UPDATE dentro da transação de criação do laudo.
model LaudoSequencia {
  ano          Int @id
  ultimoNumero Int @default(0)

  @@map("laudo_sequencias")
}

// ─────────────────────────── Laudo ───────────────────────────

model Laudo {
  id            String      @id @default(cuid())
  numero        String      @unique
  produtorId    String
  produtor      Produtor    @relation(fields: [produtorId], references: [id])
  propriedadeId String
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id])
  safraId       String
  safra         Safra       @relation(fields: [safraId], references: [id])
  agronomoId    String
  agronomo      Agronomo    @relation(fields: [agronomoId], references: [id])

  status        StatusLaudo @default(RASCUNHO)
  cidadeEmissao String
  dataEmissao   DateTime    @default(now())
  observacoes   String?

  // Consolidado — resultado de core.consolidar() sobre os itens, persistido para
  // não recalcular a cada listagem/exportação.
  totalFaturamento Decimal @db.Decimal(18, 2) @default(0)
  totalCusto       Decimal @db.Decimal(18, 2) @default(0)
  totalReceita     Decimal @db.Decimal(18, 2) @default(0)
  margemPercentual Decimal @db.Decimal(6, 2) @default(0)

  hashDocumento String?

  itens       LaudoItem[]
  assinaturas Assinatura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([produtorId])
  @@index([safraId])
  @@index([status])
  @@map("laudos")
}

/// Snapshot do item calculado no momento da emissão: nome/unidade/preço/custo são
/// copiados da Atividade/CotacaoRef vigentes NAQUELE instante. Atualizar a matriz de
/// preços depois não pode alterar um laudo já emitido — é o que garante que reimprimir
/// um laudo antigo mostra exatamente o que o banco recebeu.
model LaudoItem {
  id          String    @id @default(cuid())
  laudoId     String
  laudo       Laudo     @relation(fields: [laudoId], references: [id], onDelete: Cascade)
  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id])

  atividadeNome String
  unidade       String

  areaHa         Decimal  @db.Decimal(14, 2)
  produtividade  Decimal  @db.Decimal(14, 2)
  precoUnitario  Decimal  @db.Decimal(18, 4)
  custoPorHa     Decimal  @db.Decimal(18, 4)
  rebanhoCabecas Decimal? @db.Decimal(14, 2)

  producaoTotal      Decimal  @db.Decimal(18, 2)
  faturamentoBruto   Decimal  @db.Decimal(18, 2)
  custoTotal         Decimal  @db.Decimal(18, 2)
  receitaLiquida     Decimal  @db.Decimal(18, 2)
  produtividadePorHa Decimal? @db.Decimal(14, 2)
  taxaLotacao        Decimal? @db.Decimal(14, 2)

  ordem Int @default(0)

  createdAt DateTime @default(now())

  @@index([laudoId])
  @@map("laudo_itens")
}

model Assinatura {
  id             String         @id @default(cuid())
  laudoId        String
  laudo          Laudo          @relation(fields: [laudoId], references: [id], onDelete: Cascade)
  tipo           TipoAssinatura
  nomeSignatario String
  /// CPF do produtor ou CREA do agrônomo
  documento      String
  imagemBase64   String?
  hash           String?
  assinadoEm     DateTime?
  ip             String?
  userAgent      String?
  token          String?   @unique
  tokenExpiraEm  DateTime?

  createdAt DateTime @default(now())

  @@index([laudoId])
  @@map("assinaturas")
}
