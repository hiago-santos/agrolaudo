# Em desenvolvimento, omita o arquivo ou use http://localhost:8000.
# Em produção o valor é embutido no BUILD do Vite — defina no painel do host
# (Railway/Vercel) como variável de build, não só no runtime do container.
# Ex.: VITE_API_URL=https://agrolaudo-api.up.railway.app
VITE_API_URL=http://localhost:8000

# Chave da Maps JavaScript API do Google Cloud Console — usada pra desenhar o contorno
# das propriedades e a área financiada dos projetos. Sem ela, os mapas mostram um aviso
# mas o resto do app funciona normalmente.
# Como gerar: console.cloud.google.com → APIs & Services → Credentials → Create API key
# → habilite "Maps JavaScript API" no projeto → restrinja a chave por HTTP referrer aos
# domínios do app (localhost:5173 em dev, seu domínio de produção).
VITE_GOOGLE_MAPS_API_KEY=
